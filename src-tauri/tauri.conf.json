{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "timetracker",
  "version": "1.2.0",
  "identifier": "com.sam.timetracker",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/timetracker/browser"
  },
  "app": {
    "windows": [
      {
        "title": "timetracker",
        "width": 800,
        "height": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-src 'none'; object-src 'none'; upgrade-insecure-requests;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
