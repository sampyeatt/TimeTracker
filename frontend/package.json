{
  "name": "TimeTracker",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng build --base-href && npm run electron:start",
    "build": "ng build",
    "electron:build": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "electron:start": "electron .",
    "electron:build-deb": "npm run electron:build && electron-builder --linux deb tar.xz"
  },
  "build": {
    "appId": "TimeTrackerApp",
    "files": [
      "dist/frontend",
      "main-electron.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "linux": {
      "target": "deb",
      "category": "Utility",
      "executableName": "timetracker",
      "icon": "assets/icon.png",
      "synopsis": "Time Tracker Application"
    },
    "deb": {
      "packageName": "timetracker"
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.14",
    "@angular/compiler": "^20.3.14",
    "@angular/core": "^20.3.14",
    "@angular/forms": "^20.3.14",
    "@angular/platform-browser": "^20.3.14",
    "@angular/platform-server": "^20.3.14",
    "@angular/router": "^20.3.14",
    "@angular/ssr": "^20.3.12",
    "@primeuix/themes": "^2.0.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "express": "^5.1.0",
    "postcss": "^8.5.6",
    "primeicons": "^7.0.0",
    "primeng": "^20.3.0",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.12",
    "@angular/cli": "^20.3.12",
    "@angular/compiler-cli": "^20.3.14",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@types/express": "^5.0.5",
    "@types/jasmine": "~5.1.13",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "jasmine-core": "~5.12.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  },
  "description": "Time Tracker Application to track your work hours.",
  "main": "main-electron.js",
  "homepage": "https://github.com/sampyeatt/TimeTracker",
  "keywords": [],
  "author": {
    "name": "Sam Pyeatt",
    "email": "sampyeatt@gmail.com"
  },
  "license": "ISC"
}
