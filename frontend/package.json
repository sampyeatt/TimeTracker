{
  "name": "TimeTrackerApp",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start:front": "ng serve",
    "build:front": "ng build",
    "electron:build": "ng build --base-href ./",
    "electron:start": "electron .",
    "electron:build-deb": "npm run electron:build && electron-builder --linux flatpak",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:back": "ts-node ../src-back/index.ts",
    "dev": "nodemon ../src-back/index.ts",
    "build:back": "npx tsc"
  },
  "build": {
    "asar": true,
    "appId": "com.time.trackerapp",
    "linux": {
      "target": "flatpak",
      "category": "Utility",
      "icon": "./512x512.png"
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist_electron"
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-server": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@angular/ssr": "^20.2.1",
    "@primeuix/themes": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "express": "^5.1.0",
    "postcss": "^8.5.6",
    "primeicons": "^7.0.0",
    "primeng": "^20.0.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.12",
    "tslib": "^2.3.0",
    "vite-plugin-angular": "^0.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "node-ipc": "^12.0.0",
    "resend": "^6.2.0-preview-contacts.0",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "^5.1.7",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.20.1",
    "@angular/build": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "@types/validator": "^13.15.2",
    "dotenv": "^17.2.1",
    "eslint": "^9.34.0",
    "express": "^5.1.0",
    "install": "^0.13.0",
    "nodemon": "^3.1.10",
    "npm": "^11.5.2",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "description": "Time Tracker Application to track your work hours.",
  "main": "main-electron.js",
  "keywords": [],
  "homepage": "https://github.com/sampyeatt/TimeTracker",
  "author": {
    "name": "Sam Pyeatt",
    "email": "sampyeatt@gmail.com"
  },
  "license": "ISC"
}
